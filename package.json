{
	"name": "standalone-react-biome",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc",
		"clean": "rm -rf dist",
		"reinstall": "rm -rf dist node_modules pnpm-lock.yaml && pnpm install",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write . && prettier --write \"**/*.{html,css}\"",
		"check": "biome ci . && prettier --check \"**/*.{html,css}\""
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.0.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.0",
		"@biomejs/biome": "^2.5.15",
		"prettier": "^3.9.9"
	}
}
