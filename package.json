		"astro": "^7.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.0",
		"typescript": "^6.0.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@^1.0.0",
		"vite-plus": "^1.0.0"
	}
