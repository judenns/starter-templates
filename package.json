{
	"name": "starter-templates",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=22.12",
		"pnpm": ">=12"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "pnpm -r --parallel run dev",
		"build": "pnpm -r run build",
		"typecheck": "pnpm -r run typecheck",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write . && prettier --write \"**/*.{html,css,astro}\"",
		"check": "biome ci . && prettier --check \"**/*.{html,css,astro}\"",
		"create-project": "node scripts/create-project.js"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-astro": "catalog:"
	},
	"prettier": "./toolchains/biome/astro/files/.prettierrc.json"
}
