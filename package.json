{
	"name": "standalone-vanilla-js",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"format": "biome format --write ./src && prettier --write \"./src/**/*.{html,css}\"",
		"ci": "biome ci ./src",
		"clean": "rm -rf dist",
		"reinstall": "rm -rf dist node_modules pnpm-lock.yaml && pnpm install"
	},
	"devDependencies": {
		"autoprefixer": "^10.6.1",
		"cssnano": "^9.3.2",
		"postcss": "^8.5.29",
		"postcss-import": "^17.0.0",
		"postcss-preset-env": "^11.6.1",
		"vite": "^8.1.6",
		"@biomejs/biome": "^2.5.15",
		"prettier": "^3.9.9"
	},
	"browserslist": [
		"defaults and fully supports es6-module",
		"not dead"
	]
}
