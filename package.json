{
	"name": "standalone-vanilla-js",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"format": "biome format --write ./src && prettier --write \"./src/**/*.{html,css}\"",
		"ci": "biome ci ./src",
		"clean": "rm -rf dist",
		"reinstall": "rm -rf dist node_modules pnpm-lock.yaml && pnpm install"
	},
	"devDependencies": {
		"cssnano": "^9.0.0",
		"postcss": "^8.5.0",
		"postcss-preset-env": "^11.0.0",
		"vite": "^8.0.0",
		"@biomejs/biome": "^2.5.15",
		"prettier": "^3.9.9"
	},
	"browserslist": [
		"baseline widely available on 2026-01-01"
	]
}
