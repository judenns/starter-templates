{
	"name": "starter-templates",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=22.12",
		"pnpm": ">=12"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "pnpm -r --parallel run dev",
		"build": "pnpm -r run build",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write . && prettier --write \"**/*.{html,css}\"",
		"ci": "biome ci .",
		"create-project": "node scripts/create-project.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"prettier": "^3.9.9"
	},
	"browserslist": [
		"baseline widely available on 2026-01-01"
	]
}
