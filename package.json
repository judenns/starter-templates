{
	"name": "standalone-astro-biome",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"typecheck": "astro check",
		"astro": "astro",
		"clean": "rm -rf dist .astro",
		"reinstall": "rm -rf dist .astro node_modules pnpm-lock.yaml && pnpm install",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write . && prettier --write \"**/*.{html,css,astro}\"",
		"check": "biome ci . && prettier --check \"**/*.{html,css,astro}\""
	},
	"dependencies": {
		"astro": "^7.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.0",
		"typescript": "^6.0.0",
		"@biomejs/biome": "^2.5.15",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.0.0"
	}
}
